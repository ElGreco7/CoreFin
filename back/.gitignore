# ────────────────────────────────────────────────────────────────────────────
# .gitignore — CoreFin Backend (Django + Python)
# ────────────────────────────────────────────────────────────────────────────

# ── Variáveis de ambiente (CRÍTICO — contém senhas!) ──────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Ambiente virtual ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Django ────────────────────────────────────────────────────────────────
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py

# ── Distribuição / Packaging ──────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ── Testes e coverage ─────────────────────────────────────────────────────
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# ── VS Code ───────────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── PyCharm / IntelliJ ────────────────────────────────────────────────────
.idea/
*.iml

# ── Sistema operacional ───────────────────────────────────────────────────
.DS_Store          # macOS
Thumbs.db          # Windows
desktop.ini        # Windows

# ── Arquivos temporários ──────────────────────────────────────────────────
*.swp
*.swo
*~
*.bak
*.tmp

# ── Outros ────────────────────────────────────────────────────────────────
*.pid
celerybeat-schedule
celerybeat.pid