# .env.example — copie para .env e preencha os valores reais.
# NÃO versione o .env real (já está no .gitignore se houver).

# ── Django ──────────────────────────────────────────────────────────────────
# Chave secreta usada pra criptografia/sessões. Em dev: qualquer string longa.
# Em prod: gerar uma aleatória de pelo menos 50 caracteres.
SECRET_KEY=troque-por-uma-chave-secreta-longa

# True em dev, False em prod (NUNCA True em produção).
DEBUG=True


# ── Banco de Dados (PostgreSQL) ────────────────────────────────────────────
DB_NAME=corefin
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# ── CORS ───────────────────────────────────────────────────────────────────
# Origens autorizadas a chamar a API (frontend React em dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Integrações futuras (deixar vazio por enquanto) ────────────────────────

# Chave da OpenAI ou Anthropic, pra plugar IA real no CoreChat.
# OPENAI_API_KEY=

# Configuração SMTP pra enviar emails de recuperação de senha em produção.
# Em dev, o token é printado no console.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=

GEMINI_API_KEY=